# ==========================================
# Amzy Site Skeleton - Tenant Environment Variables
# ==========================================

# 1. Database Connection (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 2. Amzy Hub Webhook Ingestion Secret
DISPATCH_WEBHOOK_SECRET="sec_amzy_tenant_webhook_secret_here"
REVIEWS_WEBHOOK_SECRET="sec_amzy_reviews_secret_here"

# 3. Tenant Branding & Identity (Injected by Amzy Launcher)
TENANT_ID="amzy_tenant_uuid"
NEXT_PUBLIC_SITE_NAME="Your Brand Junk Removal"
NEXT_PUBLIC_SITE_TAGLINE="Eco-Friendly Junk Removal & Cleanouts"
NEXT_PUBLIC_SITE_DESCRIPTION="Certified landfill diversion and verified proof-of-work hauling."
NEXT_PUBLIC_SITE_URL="https://starter.amzy.app"
NEXT_PUBLIC_PHONE_DISPLAY="(555) 019-2834"
NEXT_PUBLIC_PHONE_RAW="+15550192834"
NEXT_PUBLIC_EMAIL="dispatch@yourdomain.com"
NEXT_PUBLIC_BRAND_COLOR="#D94F04"
NEXT_PUBLIC_MARKET_STATE="WA"
NEXT_PUBLIC_MARKET_COUNTY="King County"
NEXT_PUBLIC_AMZY_HUB_URL="https://api.amzy.app"

# 4. Optional Direct Review Channels (if not proxied via Amzy)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
YELP_API_KEY=""
